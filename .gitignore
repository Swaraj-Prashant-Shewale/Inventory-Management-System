build/
dist/
*.spec

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# The Supabase CA is a public certificate, not a secret, and every warehouse PC needs
# it — so it is committed and shipped deliberately.
!certs/supabase-ca.crt
