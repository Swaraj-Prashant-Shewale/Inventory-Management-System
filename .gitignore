# Secrets - never commit
.env
.env.*
!.env.example
web_secret.key
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
.npmrc
.pypirc
credentials*.json
service-account*.json

# Personal notes - keep local
HOW_TO_UPLOAD_TO_GITHUB.txt

# Local databases and backups
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.backup
backups/

# Logs and generated documents
*.log
documents/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# PyInstaller and release artifacts (publish binaries as GitHub Release assets)
build/
dist/
*.spec
release/
releases/
*.exe
*.msi
*.zip
*.7z
*.tar
*.tar.gz

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# The Supabase CA is a public certificate, not a secret, and every warehouse PC needs
# it - so it is committed and shipped deliberately.
!certs/supabase-ca.crt

.vercel/