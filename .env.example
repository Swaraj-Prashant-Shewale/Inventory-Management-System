# Copy to .env and fill in. Never commit .env — it holds the database password.

# "sqlite" for local development, "postgres" for the shared cloud database.
DB_BACKEND=sqlite

# --- SQLite (local development) -----------------------------------------------
SQLITE_FILE=inventory_dev.db

# --- PostgreSQL / Supabase (production) ---------------------------------------
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# --- Application ---------------------------------------------------------------
CURRENCY_SYMBOL=₹
FY_START_MONTH=4
DEFAULT_GST_RATE=18
DEBUG=false
